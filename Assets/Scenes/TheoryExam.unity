--- !u!114 &396332108
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 396332106}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><size=24><color=#0F6CBD>I. M\u1EB9o tr\u1EA3 l\u1EDDi nhanh c\xE1c
    c\xE2u h\u1ECFi v\u1EC1 Quy t\u1EAFc & Kh\xE1i ni\u1EC7m</color></size></b>\n\u0110\xE2y
    l\xE0 ph\u1EA7n chi\u1EBFm s\u1ED1 l\u01B0\u1EE3ng c\xE2u h\u1ECFi l\u1EDBn nh\u1EA5t.
    H\xE3y \u01B0u ti\xEAn c\xE1c t\u1EEB kh\xF3a sau \u0111\u1EC3 ch\u1ECDn \u0111\xE1p
    \xE1n \u0111\xFAng trong \"1 n\u1ED1t nh\u1EA1c\":\n\n  <b>1. C\u1EE5m t\u1EEB
    \"V\xE0ng\" - Th\u1EA5y l\xE0 ch\u1ECDn</b>\n  N\u1EBFu trong c\xE1c ph\u01B0\u01A1ng
    \xE1n tr\u1EA3 l\u1EDDi c\xF3 ch\u1EE9a nh\u1EEFng c\u1EE5m t\u1EEB sau, h\xE3y
    ch\u1ECDn ngay m\xE0 kh\xF4ng c\u1EA7n \u0111\u1ECDc h\u1EBFt c\xE2u h\u1ECFi:\n 
    \u2022 \"B\u1ECB nghi\xEAm c\u1EA5m\" ho\u1EB7c \"Kh\xF4ng \u0111\u01B0\u1EE3c...\"
    (V\xED d\u1EE5: Kh\xF4ng \u0111\u01B0\u1EE3c ph\xE9p, kh\xF4ng \u0111\u01B0\u1EE3c
    quay \u0111\u1EA7u...).\n  \u2022 \"UBND c\u1EA5p t\u1EC9nh\".\n  \u2022 \"C\u01A1
    quan, t\u1ED5 ch\u1EE9c, c\xE1 nh\xE2n\".\n\n  <b>2. M\u1EB9o ph\xE2n bi\u1EC7t
    ph\u01B0\u01A1ng ti\u1EC7n</b>\n  \u2022 Xe c\u01A1 gi\u1EDBi: Ch\u1ECDn \u0111\xE1p
    \xE1n KH\xD4NG c\xF3 c\u1EE5m t\u1EEB \"xe cho ng\u01B0\u1EDDi khuy\u1EBFt t\u1EADt\".\n 
    \u2022 Xe th\xF4 s\u01A1: Ch\u1ECDn \u0111\xE1p \xE1n C\xD3 c\u1EE5m t\u1EEB
    \"xe cho ng\u01B0\u1EDDi khuy\u1EBFt t\u1EADt\".\n  \u2022 Tu\u1ED5i l\xE1i xe:
    16 tu\u1ED5i (xe d\u01B0\u1EDBi 50cm3); 18 tu\u1ED5i (xe t\u1EEB 50cm3 tr\u1EDF
    l\xEAn - H\u1EA1ng A1).\n\n  <b>3. Quy t\u1EAFc nh\u01B0\u1EDDng \u0111\u01B0\u1EDDng</b>\n 
    \u2022 Nh\u01B0\u1EDDng cho xe \u0111i tr\xEAn \u0111\u01B0\u1EDDng \u01B0u ti\xEAn,
    \u0111\u01B0\u1EDDng ch\xEDnh.\n  \u2022 Nh\u01B0\u1EDDng cho ng\u01B0\u1EDDi
    \u0111i b\u1ED9 \u0111ang \u0111i tr\xEAn ph\u1EA7n \u0111\u01B0\u1EDDng quy
    \u0111\u1ECBnh.\n  \u2022 V\xF2ng xuy\u1EBFn: C\xF3 b\xE1o hi\u1EC7u (nh\u01B0\u1EDDng
    b\xEAn tr\xE1i), kh\xF4ng b\xE1o hi\u1EC7u (nh\u01B0\u1EDDng b\xEAn ph\u1EA3i).\n\n<b><size=24><color=#0F6CBD>II.
    Tuy\u1EC7t chi\xEAu gi\u1EA3i nhanh ph\u1EA7n Bi\u1EC3n b\xE1o giao th\xF4ng</color></size></b>\n 
    <b>1. H\u1EC7 th\u1ED1ng bi\u1EC3n b\xE1o th\u01B0\u1EDDng g\xE2y nh\u1EA7m l\u1EABn,
    h\xE3y nh\u1EDB c\xE1c quy t\u1EAFc \"b\u1EA5t th\xE0nh v\u0103n\" sau:</b>\n 
    \u2022 Bi\u1EC3n tr\xF2n \u0111\u1ECF: Bi\u1EC3n c\u1EA5m (C\u1EA5m g\xEC v\u1EBD
    n\u1EA5y).\n  \u2022 Bi\u1EC3n tam gi\xE1c v\xE0ng: Bi\u1EC3n nguy hi\u1EC3m.\n 
    \u2022 Bi\u1EC3n tr\xF2n xanh: Hi\u1EC7u l\u1EC7nh (Ph\u1EA3i thi h\xE0nh).\n 
    \u2022 Bi\u1EC3n h\xECnh vu\xF4ng/ch\u1EEF nh\u1EADt xanh: Ch\u1EC9 d\u1EABn.\n\n 
    <b>2. M\u1EB9o nh\u1EDB cho bi\u1EC3n c\u1EA5m: C\u1EA5m xe nh\u1ECF = C\u1EA5m
    lu\xF4n xe l\u1EDBn.</b>\n  \u2022 C\u1EA5m xe l\u1EDBn = Kh\xF4ng c\u1EA5m xe
    nh\u1ECF.\n  \u2022 S\u01A1 \u0111\u1ED3 \u01B0u ti\xEAn: Xe con -> Xe t\u1EA3i
    -> Xe k\xE9o.\n\n<b><size=24><color=#0F6CBD>III. L\u01B0u \xFD quan tr\u1ECDng
    \u0111\u1EC3 kh\xF4ng b\u1ECB \"li\u1EC7t\" khi \u0111i thi</color></size></b>\n 
    \u2022 <b>\u0110\u1ECDc k\u1EF9 c\xE2u h\u1ECFi:</b> Tuy\u1EC7t \u0111\u1ED1i
    kh\xF4ng \u0111\u01B0\u1EE3c l\xE0m sai c\xE2u h\u1ECFi \u0111i\u1EC3m li\u1EC7t
    (c\xE2u v\u1EC1 h\xE0nh vi b\u1ECB nghi\xEAm c\u1EA5m, say r\u01B0\u1EE3u bia
    l\xE1i xe...).\n  \u2022 <b>T\xE2m l\xFD b\xECnh t\u0129nh:</b> \u0110\u1EBFn
    s\u1EDBm 30 ph\xFAt \u0111\u1EC3 \u1ED5n \u0111\u1ECBnh ch\u1ED7 ng\u1ED3i v\xE0
    l\xE0m quen kh\xF4ng kh\xED ph\xF2ng thi.\n  \u2022 <b>Ki\u1EC3m tra l\u1EA1i:</b>
    Lu\xF4n d\xE0nh 2 ph\xFAt cu\u1ED1i \u0111\u1EC3 r\xE0 so\xE1t l\u1EA1i to\xE0n
    b\u1ED9 \u0111\xE1p \xE1n tr\u01B0\u1EDBc khi nh\u1EA5n \"K\u1EBFt th\xFAc\"."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
